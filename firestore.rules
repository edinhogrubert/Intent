rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /intents/{intentId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.creator_id == request.auth.uid) ||
        (request.resource != null && request.resource.data.creator_id == request.auth.uid)
      );
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
