{
  "entities": {
    "Intent": {
      "title": "Intent",
      "description": "Uma intenção criada pelo usuário.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creator_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "completed", "cancelled"] },
        "created_at": { "type": "string", "format": "date-time" },
        "visibility": { "type": "string", "enum": ["private", "public"] }
      },
      "required": ["id", "creator_id", "title", "status", "created_at"]
    }
  },
  "firestore": {
    "/intents/{intentId}": {
      "schema": "Intent",
      "description": "Coleção de intenções dos usuários."
    }
  }
}
