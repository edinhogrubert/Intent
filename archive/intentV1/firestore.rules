rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    match /intents/{intentId} {
      allow get, list: if isSignedIn() && resource.data.creator_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.creator_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.creator_id == request.auth.uid && request.resource.data.creator_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.creator_id == request.auth.uid;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
